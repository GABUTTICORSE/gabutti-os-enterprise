{
  "name": "gs-one",
  "version": "0.8.2",
  "description": "GS ONE - Sistema operativo de Gabutti Corse",
  "main": "index.html",
  "scripts": {
    "start": "node apps/api/server.js",
    "start:whatsapp": "node apps/api/whatsapp_server.js",
    "lint": "eslint .",
    "lint:js": "npx eslint src",
    "lint:js:fix": "npx eslint src --fix",
    "lint:report": "npx eslint src -o ./eslint-report.json --format json",
    "prettier": "prettier --write 'src/*/.js'",
    "test": "node apps/api/tests/inbox_classifier.test.js && node apps/api/tests/inbox_flow.test.js && node apps/api/tests/auth.test.js && node apps/api/tests/whatsapp_webhook.test.js && node apps/api/tests/sales_access.test.js",
    "configure:sre": "node scripts/configure-sre.js",
    "usuarios": "node scripts/usuarios.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.0.0"
  }
}
